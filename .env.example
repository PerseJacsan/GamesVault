# Local development: APP_ENV=development. Production: APP_ENV=production and use a random SECRET_KEY of at least 32 characters.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
# Local development uses loopback HTTP.
SESSION_COOKIE_SECURE=0
ALLOW_REGISTRATION=1
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Optional custom database location. A fresh install defaults to instance/gamesvault.db.
# GAMESVAULT_DB_PATH=instance/gamesvault.db

# Optional Steam Web API key. If blank, GamesVault uses Steam public Store search for local development.
# Keep this server-side. Never expose it in frontend JavaScript.
STEAM_API_KEY=

# Initial/refresh catalogue target for local development.
STEAM_CATALOGUE_TARGET=750

# Number of Store detail IDs handled per batch.
STEAM_DETAIL_BATCH_SIZE=50

# Optional development override. When set, normal catalogue discovery is skipped
# and only these App IDs are fetched directly from Steam Store appdetails.
# Example: 570,730,1091500
# STEAM_SYNC_APPIDS=
